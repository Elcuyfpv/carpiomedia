          "texts_in_order": [
            {
              "tag": "p",
              "text": "Carpio Media produces commercial real estate photography, aerial drone video, and property marketing content for developers, owners, brokers, property managers, architects, construction teams, and agencies. Based in Forest Hills, Queens, we serve commercial properties throughout New York City, Long Island, Westchester, New Jersey, and Connecticut."
            },
            {
              "tag": "p",
              "text": "Coverage can support office, retail, industrial, hospitality, mixed-use, multifamily, development, and construction projects. Ground photography documents architecture, interiors, amenities, and tenant experience; aerial imagery shows access, scale, surrounding infrastructure, and neighborhood context."
            },
            {
              "tag": "p",
              "text": "Projects can be planned for leasing campaigns, investor presentations, development milestones, construction progress, corporate communications, and recurring property documentation. Drone operations are evaluated for airspace, site conditions, people, traffic, and production requirements before launch."
            },
            {
              "tag": "p",
              "text": "To request a quote, send the property address, preferred date, project type, required deliverables, intended audience, and campaign or milestone deadline through the Contact page."
            }
          ],
