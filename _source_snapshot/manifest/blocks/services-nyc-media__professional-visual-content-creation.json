          "texts_in_order": [
            {
              "tag": "p",
              "text": "Carpio Media creates professional photo and video content for brands, agencies, corporate teams, events, properties, and organizations throughout New York City and the Tri-State Area. Based in Forest Hills, Queens, we produce polished visual assets for websites, social media, advertising, presentations, press, and internal communications."
            },
            {
              "tag": "p",
              "text": "Each project is planned around the audience, platform, location, and campaign goal. Coverage can combine ground cameras, stabilized movement, interviews, event highlights, product or workplace details, and aerial footage when appropriate and permitted."
            },
            {
              "tag": "p",
              "text": "We support brand campaigns, corporate events, conferences, launches, hospitality, community programs, and ongoing social content. The work below includes event recaps and branded projects from Carpio Media's existing portfolio."
            },
            {
              "tag": "p",
              "text": "To request a quote, send the date and location, intended platforms, required deliverables, event schedule or shot priorities, deadline, and any brand guidelines through the Contact page."
            }
          ],
