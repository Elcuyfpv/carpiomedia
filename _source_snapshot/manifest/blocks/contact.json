          "texts_in_order": [
            {
              "tag": "h2",
              "text": "Let’s Create Something People Will Remember"
            },
            {
              "tag": "p",
              "text": "Carpio Media creates FAA compliant drone photography, cinematic video, FPV fly throughs, and visual content for real estate professionals, brands, agencies, production teams, events, and organizations across Queens, New York City, Long Island, Westchester, New Jersey, and Connecticut."
            },
            {
              "tag": "p",
              "text": "Tell us what you are planning, where it will happen, and when you need the finished work. We will review the details, recommend the right approach, and send a clear quote."
            }
          ],
