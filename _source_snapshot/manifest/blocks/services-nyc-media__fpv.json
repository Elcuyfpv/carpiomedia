          "texts_in_order": [
            {
              "tag": "p",
              "text": "Carpio Media produces immersive FPV drone video for commercials, branded content, film and television, real estate, hospitality, sports, events, and complex spaces. Based in Forest Hills, Queens, we serve projects throughout New York City, Long Island, Westchester, New Jersey, and Connecticut."
            },
            {
              "tag": "p",
              "text": "Unlike traditional aerial shots, FPV cameras can follow planned routes through entrances, rooms, corridors, venues, and exterior environments to connect multiple spaces in one continuous-feeling sequence. Depending on the creative and production requirements, FPV systems can support lightweight action cameras or cinema-camera payloads."
            },
            {
              "tag": "p",
              "text": "Every route is designed around the location, people, obstacles, airspace, permissions, lighting, speed, and safe launch and recovery zones. Pre-production can include a site review, flight-path planning, rehearsals, coordination with talent and crew, and multiple takes."
            },
            {
              "tag": "p",
              "text": "To request a quote, send the location, whether the route is indoors or outdoors, the concept or visual reference, planned path, preferred date, crew or talent details, required deliverables, deadline, and any property or production restrictions through the Contact page."
            }
          ],
          "images_in_order": [],
          "youtube_ids": [],
